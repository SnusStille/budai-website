# Copy this file to .env.local for local development
# Never commit real secrets to Git.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
ADMIN_PASSWORD=
NEXT_PUBLIC_SITE_URL=https://stilledev.se

ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_WORKSPACE_ID=your-workspace-id
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Playground model tiers (optional) ─────────────────────────────────────────
# ANTHROPIC_MODEL is the default "Quality" tier. Set one of these and the model
# picker appears in the playground composer — it only ever offers tiers that are
# actually configured, and the browser never sees a key.
# ANTHROPIC_MODEL_FAST=claude-3-5-haiku-latest
# ANTHROPIC_MODEL_DEEP=claude-sonnet-4-20250514
# The server validates every requested tier and falls back to ANTHROPIC_MODEL,
# so an unset tier can never be selected from the browser.
