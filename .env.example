# Copy to .env.local and replace every placeholder. Never commit .env.local.
# After editing, run `npm run check:env` — it reports presence/shape only,
# never the values themselves.

# ── Required for full functionality ──────────────────────────────────────────
# Public (sent to the browser by design, protected by RLS):
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never prefix these with NEXT_PUBLIC_:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-key
ADMIN_PASSWORD=
NEXT_PUBLIC_SITE_URL=https://stilledev.se

# ── Optional ─────────────────────────────────────────────────────────────────
# ANTHROPIC_MODEL is the default "Quality" tier. Setting FAST or DEEP makes the
# model picker appear in the composer; only configured tiers are offered and the
# browser never sees a key or a model id it was not given.
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_MODEL_FAST=claude-3-5-haiku-latest
# ANTHROPIC_MODEL_DEEP=claude-sonnet-4-20250514

# Optional image generation. Without it /api/generate-image returns 501.
# OPENAI_API_KEY=your-openai-key
# OPENAI_IMAGE_MODEL=gpt-image-1

# Emergency cost/abuse switch: 1 pauses ALL Playground generation.
# BUDAI_AI_DISABLED=1

# Optional transactional email (Resend). Without these, contact/waitlist
# confirmations are not emailed; admins get in-app notifications instead.
# RESEND_API_KEY=
# EMAIL_FROM=BudAI <hello@stilledev.se>
# ADMIN_NOTIFICATION_EMAIL=
